# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill it in.  `.env` is gitignored; this is not.
#
#   cp .env.example .env
#
# Parser notes (this project reads .env itself, it does not use `dotenv`):
#   - A real environment variable ALWAYS wins over a value in this file.
#     So `AUTH_MFA_CODE= npx playwright test` clears the code for one run.
#   - An empty value counts as unset.
#   - NO variable expansion: a `$` is a literal `$`. Good, because passwords
#     contain them.
#   - Quote the value if it contains spaces, or a `#` after a space:
#         AUTH_PASSWORD="p@ss word #1"
#     Unquoted `abc#123` is fine (no space before the `#`).
#   - Multi-line values are not supported.
# ---------------------------------------------------------------------------


# --- Where to log in, and what the generated specs target -------------------

# The Privaci app login page. Note the trailing `/#/` - the app uses hash
# routing and drops the `#/login` fragment in itself.
AUTH_LOGIN_URL=https://qa.securiti.xyz/#/

# NOT a restriction on which module you can record/run -- a recorded spec's own
# page.goto('https://full-url...') always wins, so Domains, Datasets, Graph
# Explorer, etc. all work today regardless of what this says (proven live
# 2026-08-07 by recording a Domains flow with this still pointed at EDC). This
# value only feeds three internal things: the default `baseURL`, what page the
# harness re-visits to sanity-check "is the saved session still good", and
# which origin's localStorage gets captured right after login (see the comment
# below -- only EDC specifically needs that; cookies already cover every module
# under *.qa.securiti.xyz). Set to whichever module you work in most; changing
# it does not add or remove support for any other module.
APP_URL=https://edc.qa.securiti.xyz/

# Origins visited (in order) after a successful login, so their localStorage
# is captured into storageState. Comma-separated. Defaults to APP_URL alone.
#
# Session COOKIES are set on the wildcard domains `.qa.securiti.xyz` and
# `.securiti.xyz`, so they already cover edc.qa.securiti.xyz. But localStorage
# is origin-scoped and does NOT carry across subdomains - hence this warming
# step. If a session ever fails to carry into EDC, warm the parent app first:
# AUTH_WARM_URLS=https://qa.securiti.xyz/#/,https://edc.qa.securiti.xyz/


# --- Credentials (this file's copy is gitignored - keep it that way) --------

AUTH_EMAIL=
AUTH_PASSWORD=

# The 6-digit code, appended DIRECTLY to the password (`password` + `code`) -
# it is not a separate field and there is no OTP screen. Only appended when
# this is set.
#
# REQUIRED on qa/dev environments, including edc.qa.securiti.xyz. Leave blank
# on prod. Ask the automation team for the current value; it is deliberately
# not committed anywhere in this package.
AUTH_MFA_CODE=

# Only needed if a "Select Domain" step appears after the email step (that
# happens for accounts whose email maps to more than one tenant). Leave blank
# otherwise - if it turns out to be required, the setup fails with a
# DomainRequiredError that says so explicitly.
AUTH_DOMAIN=


# --- Session reuse ----------------------------------------------------------

# A saved session older than this triggers a fresh login. Age alone is never
# trusted: the state is also probed against APP_URL before it is reused.
AUTH_STATE_MAX_AGE_MINUTES=120

# Set to 1 to skip reuse entirely and always log in again.
AUTH_FORCE=

# Include IndexedDB in the saved state. Flip this to `true` FIRST if the login
# and warm-up both look fine but your specs still land on the login wall -
# it would mean the app keeps its token in IndexedDB rather than in cookies.
# Off by default: it bloats the state file and can restore stale app caches.
AUTH_INCLUDE_INDEXEDDB=false


# --- Runner -----------------------------------------------------------------

# false = watch the login happen. Set true for CI and for speed.
HEADLESS=false

# MATCH THE WINDOW SIZE YOU RECORDED IN. This app is responsive: below about
# 1320px it collapses toolbars into overflow menus and raises a "less than
# optimal screen size" toast, at which point recorded locators like
# getByRole('button', { name: 'Add' }) genuinely stop existing.
VIEWPORT=1920x1080

# Keep this at 1. Every worker shares the one saved session, and recorded
# specs create named entities - a second worker filling in the same name hits
# a duplicate-name validation, which surfaces as a "broken" Create button.
WORKERS=1

RETRIES=0

# Named TZ_ID on purpose: `TZ` is a real variable Node itself reads.
TZ_ID=UTC

# Which engine performs the LOGIN only; tests always run on chromium.
# storageState is engine-portable JSON, so a webkit login feeds a chromium run.
# The reference implementation this was modelled on runs its login on webkit,
# so that is the escape hatch if chromium ever struggles with the login form.
# chromium | webkit | firefox
AUTH_BROWSER=chromium


# --- Timeouts (milliseconds) ------------------------------------------------

TEST_TIMEOUT=180000
EXPECT_TIMEOUT=20000
ACTION_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000
LOGIN_TIMEOUT=90000
